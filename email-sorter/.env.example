# Copy this file to .env and edit
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
MAX_EMAILS=100
PORT=5000
# Mail source fixed at launch: graphtoken (default) or powerautomate.
# --provider on the command line overrides this value.
MAIL_PROVIDER=graphtoken
# Optional: ngrok starts automatically in powerautomate mode.
# NGROK_DOMAIN=chive-suitably-slingshot.ngrok-free.dev
# Pushed mail is authenticated with the account's webhook_token in
# private/multiuser.json; there is no shared token in .env.
INBOUND_MAX_EMAILS=500
MODEL_BACKEND=hybrid_claude   # hybrid_claude | hybrid | llama | encoder | ml | claude

# Optional, for `python run.py --compare`: mailbox address for pushed mail and
# a Graph token when using --provider graphtoken. Command-line flags win.
MAIL_OWNER=
GRAPH_TOKEN=
