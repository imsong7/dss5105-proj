# Copy this file to .env and edit
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
MAX_EMAILS=500
PORT=5001   # not 5000: macOS AirPlay Receiver uses it and answers 403
# powerautomate (default) = sign-in; each student picks a Power Automate flow
# or an Outlook token. graphtoken = no sign-in, token only.
# --provider on the command line overrides this value.
MAIL_PROVIDER=powerautomate
# ngrok is off by default (local development). Only the live machine turns it on:
# USE_NGROK=1   (or run: python run.py --tunnel)
# NGROK_DOMAIN=tubular-colony-caboose.ngrok-free.dev
# Pushed mail is authenticated with the account's webhook_token in
# private/multiuser.json; there is no shared token in .env.
INBOUND_MAX_EMAILS=500
MODEL_BACKEND=hybrid_claude   # hybrid_claude | hybrid | llama | encoder | ml | claude

# Optional, for `python run.py --compare`: mailbox address for pushed mail and
# a Graph token when using --provider graphtoken. Command-line flags win.
MAIL_OWNER=
GRAPH_TOKEN=

# Extra browser origins allowed to change data (e.g. a Figma preview site).
# Pages on this computer (localhost / 127.0.0.1, any port) are always allowed.
# ALLOWED_ORIGINS=https://your-preview.figma.site
