# Copy this file to .env and edit
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
MAX_EMAILS=100
PORT=5000
# Shared secret for POST /api/inbound/outlook (Power Automate).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mail source fixed at launch: graphtoken (default) or powerautomate.
# --provider on the command line overrides this value.
MAIL_PROVIDER=graphtoken
# Optional: ngrok starts automatically in powerautomate mode.
# NGROK_DOMAIN=chive-suitably-slingshot.ngrok-free.dev
POWER_AUTOMATE_WEBHOOK_TOKEN=
# Optional: "When an HTTP request is received" trigger URL of the same flow,
# so the dashboard can ask for the latest mail after someone confirms their email.
POWER_AUTOMATE_REFRESH_URL=
INBOUND_MAX_EMAILS=500
MODEL_BACKEND=hybrid_claude   # hybrid_claude | hybrid | llama | bert | ml | claude

# Optional, for `python run.py --compare`: mailbox address for pushed mail and
# a Graph token when using --provider graphtoken. Command-line flags win.
MAIL_OWNER=
GRAPH_TOKEN=
