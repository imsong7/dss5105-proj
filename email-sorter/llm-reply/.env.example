# Copy this file to .env and fill in your own values.

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=
# Shared with the repo's Claude action classifier (defaults to claude/config.yaml)
# CLAUDE_MODEL=claude-haiku-5-5

# Who the reply is written as. Optional: when omitted, the mailbox owner is
# detected from the To recipient in received_mails.json (the logged-in user).
# REPLY_SENDER_NAME=Amelia Kang
# REPLY_SENDER_EMAIL=ameliakang@u.nus.edu
