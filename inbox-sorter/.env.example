# Copy to .env and fill in. Never commit .env.

# Claude API key from the Claude Console (API Keys page)
ANTHROPIC_API_KEY=
# Optional: overrides claude.model in config.yaml
CLAUDE_MODEL=

# Optional: a Graph Explorer token. Easier: paste it in the dashboard sidebar.
# It expires after about an hour.
GRAPH_TOKEN=

# Required if the dashboard is reachable from anywhere other than your own machine
DASHBOARD_PASSWORD=
